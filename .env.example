# ---- domain (A record must already point to your server's IP) ----
DOMAIN=shop.yourdomain.com

# ---- Django ----
DJANGO_DEBUG=0
# Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_ALLOWED_HOSTS=shop.yourdomain.com
SITE_URL=https://shop.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.yourdomain.com
# Obscure admin path, trailing slash required. Pick your own random string.
DJANGO_ADMIN_URL=manage-CHANGE-ME-x7k2/
BEHIND_PROXY=1
ORDER_HOLD_HOURS=24

# ---- Postgres (POSTGRES_HOST must stay "db" for docker compose) ----
POSTGRES_DB=clbr
POSTGRES_USER=clbr
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Shared rate-limit counters across gunicorn workers (redis service is in docker-compose.yml)
REDIS_URL=redis://redis:6379/1
# Start low; after a few good days set 31536000
HSTS_SECONDS=3600
