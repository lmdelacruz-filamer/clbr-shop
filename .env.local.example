# LOCAL development settings. Copy this file to ".env" in the project folder (same folder as manage.py).
# The app reads it automatically, so you no longer type $env:... lines. NEVER upload this file to the server.
DJANGO_DEBUG=1

# PostgreSQL on your own computer. Create the database once:
#   psql -U postgres -c "CREATE DATABASE clbr;"
POSTGRES_DB=clbr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# No Postgres? Remove the POSTGRES_ lines above and uncomment this instead:
# USE_SQLITE=1
